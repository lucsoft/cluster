/// Stage two: turn one JSON Schema into Pkl.
///
/// The schema is produced by the service (schema.ts) — a chart's own values.schema.json
/// when it ships one, inferred from values.yaml otherwise, with every vendored subchart
/// composed in. This module is a thin wrapper around the pkl-pantry json_schema
/// generator, which renders schema `default`s as doc comments rather than Pkl defaults;
/// that is what keeps unset properties out of the rendered values.
///
/// Usage:
///
/// ```
/// pkl eval generate.pkl -p schemaUri=file:///tmp/x/Values.json -p chart=grafana -p chartVersion=12.7.3 -m out/
/// ```
@ModuleInfo { minPklVersion = "0.29.0" }
module lucsoft.pkl_helmchart.generate

import
  "package://pkg.pkl-lang.org/pkl-pantry/org.json_schema.contrib@1.2.4#/internal/ModulesGenerator.pkl"
import "package://pkg.pkl-lang.org/pkl-pantry/org.json_schema@1.1.1#/JsonSchema.pkl"
import "package://pkg.pkl-lang.org/pkl-pantry/org.json_schema@1.1.1#/Parser.pkl"
import "package://pkg.pkl-lang.org/pkl-pantry/pkl.experimental.uri@1.0.4#/URI.pkl"

local schemaUri: String = read("prop:schemaUri")
local chart: String = read("prop:chart")
local chartVersion: String = read("prop:chartVersion")
local chartRepository: String = read("prop:chartRepository")
local chartAppVersion: String = read?("prop:chartAppVersion") ?? ""

local generator: ModulesGenerator = new {
  rootSchema = Parser.parse(read(schemaUri)) as JsonSchema
  baseUri = URI.parse(schemaUri)!!
}

local rootModule = generator.modules.first

// Deep-converts the typed values into a `Dynamic`, which is what ArgoCD's
// `helm.valuesObject` expects. Properties left unset stay null and the YAML renderer
// omits them, so only what was actually set reaches the chart.
local toValuesSource: String = """

  /// Converts typed values into the `Dynamic` ArgoCD's `helm.valuesObject` takes.
  ///
  /// Unset properties are dropped, so the rendered Application carries only overrides.
  /// The result is a plain `Dynamic`, so anything the generated classes do not declare
  /// can be amended onto it using entry syntax:
  ///
  /// ```
  /// valuesObject = (toValues(new Values { ... }) as Dynamic) {
  ///   ["someUndeclaredKey"] { ["nested"] = "value" }
  /// }
  /// ```
  function toValues(value: Any): Any =
    if (value is Typed) new Dynamic { for (k, v in value.toMap()) { [k] = toValues(v) } }
    else if (value is Mapping) new Dynamic { for (k, v in value) { [k] = toValues(v) } }
    else if (value is Listing) new Listing { for (v in value) { toValues(v) } }
    else value

  /// The chart this module was generated from.
  ///
  /// Hidden so it stays readable without being rendered into the values.
  hidden chartName: String = "\(chart)"

  /// The chart version this module was generated from. Keep an Application's
  /// `targetRevision` in step with it.
  hidden chartVersion: String = "\(chartVersion)"

  /// The repository the chart was pulled from.
  hidden chartRepository: String = "\(chartRepository)"
  """

local header: String = """
  /// Values for the `\(chart)` Helm chart, version `\(chartVersion)`.
  ///
  /// Generated by pkl-helmchart from `\(chartRepository)`.\(if (chartAppVersion == "") "" else " App version `\(chartAppVersion)`.")
  ///
  /// Every property is nullable with no default: what you do not set is not rendered,
  /// so the chart's own defaults apply. Defaults are documented per property.
  """

// The generator's own doc comment is replaced with one naming the chart, and the module
// is reopened so consumers can extend it.
local function fixupRoot(rendered: String): String =
  let (withoutDoc = rendered.replaceFirst(Regex(#"(?s)\A(///[^\n]*\n)+"#), ""))
    header + "\n" + withoutDoc.replaceFirst(Regex("(?m)^(?!open )module "), "open module ") + toValuesSource

output {
  files {
    ["\(rootModule.moduleName).pkl"] {
      text = fixupRoot(rootModule.moduleNode.render(""))
    }
    for (other in generator.modules.drop(1)) {
      ["\(other.moduleName).pkl"] {
        text = other.moduleNode.render("")
      }
    }
  }
}
