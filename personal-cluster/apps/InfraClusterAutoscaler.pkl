/// Cluster Autoscaler with the Hetzner Cloud provider: creates and destroys hcloud servers as
/// pending pods demand capacity. New servers boot a Talos snapshot and join via the cloud-init
/// worker machine config carried in the `cluster-autoscaler-hetzner-config` Secret.
///
/// The two prerequisites live outside this file:
///   - a Talos *snapshot* in the hcloud project, labelled `os=talos,cluster=hmsys.de`. Hetzner's
///     official Talos offering is a public ISO, which server creation cannot boot from — the
///     autoscaler passes an Image to ServerCreateOpts, so the snapshot has to be your own.
///   - `deno task autoscaler-config`, which seals the worker machine config into secrets/
amends "@ArgoCD/App.pkl"

import "../components/ClusterAutoscalerPools.pkl"

name = "infra-cluster-autoscaler"
namespace = "kube-system"

sources {
  new {
    repoURL = "https://kubernetes.github.io/autoscaler"
    chart = "cluster-autoscaler"
    // renovate: datasource=helm registryUrl=https://kubernetes.github.io/autoscaler packageName=cluster-autoscaler
    targetRevision = "9.59.0"
    helm {
      releaseName = "cluster-autoscaler"
      valuesObject {
        cloudProvider = "hetzner"
        // The chart's default tag tracks the newest minor (1.35), which would run ahead of this
        // cluster's 1.34.2 API server. Cluster Autoscaler is only supported on a matching minor.
        image {
          // renovate: datasource=github-releases packageName=kubernetes/autoscaler versioning=loose
          tag = "v1.34.5"
        }
        // Only the sizing half of each pool; labels, taints and the Talos patch are the sealing
        // tool's business, and the chart has nowhere to put them.
        autoscalingGroups {
          for (pool in ClusterAutoscalerPools.pools) {
            new {
              name = pool.name
              minSize = pool.minSize
              maxSize = pool.maxSize
              instanceType = pool.instanceType
              region = pool.region
            }
          }
        }
        // Everything hcloud-specific is passed through the environment; the pool JSON is a file
        // rather than HCLOUD_CLUSTER_CONFIG because a base64 Talos machine config blows past a
        // comfortable env var size.
        extraEnv {
          ["HCLOUD_CLUSTER_CONFIG_FILE"] = "/config/cluster-config"
          // Minutes to wait for a server to come up. The default 5 is tight for a Talos boot
          // that has to pull the kubelet image before it can register.
          ["HCLOUD_SERVER_CREATION_TIMEOUT"] = "10"
          // No hcloud private network on this cluster, so nodes talk over their public IPs and
          // KubeSpan (WireGuard) encrypts everything between them.
          ["HCLOUD_PUBLIC_IPV4"] = "true"
          ["HCLOUD_PUBLIC_IPV6"] = "true"
        }
        extraEnvSecrets {
          ["HCLOUD_TOKEN"] {
            name = "hcloud"
            key = "token"
          }
        }
        // The key is only the volume name — without an explicit `name` the chart falls back to
        // its own fullname for secretName, which is not the Secret the sealing tool writes.
        extraVolumeSecrets {
          ["hetzner-cluster-config"] {
            name = "cluster-autoscaler-hetzner-config"
            mountPath = "/config"
          }
        }
        // The control plane is the only node guaranteed to outlive a scale-down, so the
        // autoscaler must not be schedulable onto the nodes it is allowed to delete.
        nodeSelector {
          ["node-role.kubernetes.io/control-plane"] = ""
        }
        tolerations {
          new {
            key = "node-role.kubernetes.io/control-plane"
            effect = "NoSchedule"
            operator = "Exists"
          }
        }
      }
    }
  }
  // hcloud API token + the sealed worker machine config; decrypted in-cluster by
  // sops-secrets-operator.
  new {
    repoURL = "https://github.com/lucsoft/cluster"
    targetRevision = "main"
    path = "personal-cluster/secrets"
    directory {
      include = "{hcloud-token,cluster-autoscaler-config}.sops.yaml"
    }
  }
}
