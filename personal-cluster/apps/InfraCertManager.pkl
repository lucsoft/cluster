amends "@ArgoCD/App.pkl"
import "@ArgoCD/Application.pkl"
import "@certManagerValues/Values.pkl"

name = "infra-cert-manager"
namespace = "cert-manager"

ignoreDifferences = new Listing<Application.ComparedToIgnoreDifference> {
  new {
    group = "admissionregistration.k8s.io"
    kind = "MutatingWebhookConfiguration"
    jqPathExpressions {
      ".webhooks[]?.clientConfig.caBundle"
    }
  }
  new {
    group = "admissionregistration.k8s.io"
    kind = "ValidatingWebhookConfiguration"
    jqPathExpressions {
      ".webhooks[]?.clientConfig.caBundle"
    }
  }
}

source {
  repoURL = "https://charts.jetstack.io"
  chart = "cert-manager"
  targetRevision = "v\(Values.chartVersion)"
  helm {
    releaseName = "cert-manager"
    valuesObject = new Values {
      crds {
        enabled = true
      }
    }.toDynamic()
  }
}
