/// Porffor (<https://porffor.dev>) as a Fission backend.
///
/// The environment image AOT-compiles the function's JS to a native binary at specialize
/// time and execs it per request, so the function is a script whose stdout is the response
/// body — see tools/fission-porffor-env.
///
/// Everything lives in the `fission` namespace because the chart's `defaultNamespace` is the
/// only namespace the control plane watches; see apps/InfraFission.pkl.
amends "@Resource/Entrypoint.pkl"

import "@k8s/api/networking/v1/Ingress.pkl"
import "@Traefik/Middleware.pkl"
import "@Fission/Environment.pkl"
import "@Fission/Function.pkl"
import "@Fission/HTTPTrigger.pkl"
import "@Fission/Package.pkl"

local functionName = "porffor"
local fissionNamespace = "fission"

local hostName = "porffor.lucsoft.de"

// The router fronts every function in the cluster; it is installed by apps/InfraFission.pkl.
local routerService = "router"
local routerPort = 80

// Fission rejects a bare "/" for both relativeurl and prefix, so the trigger owns a real
// path and Traefik rewrites the domain root onto it.
local functionPath = "/hello"

local hello = """
  const runtime = 'Porffor';
  console.log(`Hello from ${runtime}, compiled ahead of time to a native binary.`);
  """

local fissionEnvironment = new Environment {
  metadata {
    name = functionName
    namespace = fissionNamespace
  }
  spec {
    // v3 is v2's specialize contract plus a controllable pre-warm pool.
    version = 3
    poolsize = 1
    runtime {
      container {
        name = functionName
      }
      image = "ghcr.io/lucsoft/fission-porffor-env:0.1.0"
    }
  }
}

local fissionPackage = new Package {
  metadata {
    name = functionName
    namespace = fissionNamespace
  }
  spec {
    deployment {
      type = "literal"
      literal = hello.base64
    }
    environment {
      name = functionName
      namespace = fissionNamespace
    }
  }
}

resources {
  fissionEnvironment
  fissionPackage
  new Function {
    metadata {
      name = functionName
      namespace = fissionNamespace
    }
    spec {
      InvokeStrategy {
        ExecutionStrategy {
          ExecutorType = "poolmgr"
        }
        StrategyType = "execution"
      }
      environment {
        name = functionName
        namespace = fissionNamespace
      }
      package {
        packageref {
          name = functionName
          namespace = fissionNamespace
        }
      }
    }
  }
  new HTTPTrigger {
    metadata {
      name = functionName
      namespace = fissionNamespace
    }
    spec {
      functionref {
        type = "name"
        name = functionName
      }
      // Host-gated so this and the Andromeda trigger can share the router without path collisions.
      host = hostName
      relativeurl = functionPath
      methods {
        "GET"
      }
    }
  }
  // Rewrites every path on this host onto the trigger, so the domain root serves the function.
  new Middleware {
    metadata {
      name = functionName
      namespace = fissionNamespace
    }
    spec {
      replacePath {
        path = functionPath
      }
    }
  }
  new Ingress {
    metadata {
      name = functionName
      namespace = fissionNamespace
      annotations {
        ["cert-manager.io/cluster-issuer"] = "lucsoft-allinkl"
        ["traefik.ingress.kubernetes.io/router.middlewares"] = "\(fissionNamespace)-\(functionName)@kubernetescrd"
      }
    }
    spec {
      ingressClassName = "traefik"
      tls {
        new {
          hosts {
            "*.lucsoft.de"
            "lucsoft.de"
          }
          secretName = "lucsoft-tls"
        }
      }
      rules {
        new {
          host = hostName
          http {
            paths {
              new {
                path = "/"
                pathType = "Prefix"
                backend {
                  service {
                    name = routerService
                    port {
                      number = routerPort
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
