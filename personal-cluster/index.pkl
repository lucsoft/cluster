amends "@Resource/Entrypoint.pkl"

import "@ArgoCD/App.pkl"

import "./apps/Andromeda.pkl"
import "./apps/ArgoCD.pkl"
import "./apps/Emqx.pkl"
import "./apps/InfraCertManager.pkl"
import "./apps/InfraClusterAutoscaler.pkl"
import "./apps/InfraEnvoyGateway.pkl"
import "./apps/InfraFission.pkl"
import "./apps/InfraIngressController.pkl"
import "./apps/InfraSopsOperator.pkl"
import "./apps/MinecraftBedrockRelay.pkl"
import "./apps/MinecraftServer.pkl"
import "./apps/Monitoring.pkl"
import "./apps/Mqtt2Prometheus.pkl"
import "./apps/PklPackages.pkl"
import "./apps/Porffor.pkl"
import "./apps/Satisfactory.pkl"
import "./apps/VmPush.pkl"

local apps: Listing<App> = new {
  new {
    name = "infra-hetzner-index"
    namespace = "argocd"
    source {
      repoURL = "https://github.com/lucsoft/cluster"
      targetRevision = "main"
      path = "personal-cluster"
      plugin {
        parameters {
          new {
            name = "path"
            string = "index.pkl"
          }
        }
      }
    }
  }
  ArgoCD
  InfraCertManager
  InfraClusterAutoscaler
  InfraIngressController
  InfraEnvoyGateway
  InfraSopsOperator
  Satisfactory
  InfraFission
  Porffor
  Andromeda
  MinecraftServer
  MinecraftBedrockRelay
  PklPackages
  Emqx
  Monitoring
  Mqtt2Prometheus
  VmPush
}

resources {
  for (app in apps) {
    app.application
  }
}
