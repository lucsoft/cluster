  /// The type of provider to use such as "Secret", or "ConfigMap".
  type: "Secret"|"ConfigMap"
}

/// Server configures the BeyondTrust Workload Credentials server connection details. Includes the API
/// URL and Site ID for your BeyondTrust instance. For API reference, see:
/// https://docs.beyondtrust.com/bt-docs/docs/secrets-api
class Server {
  /// APIURL is the base URL of your BeyondTrust Workload Credentials API server. This should be the full
  /// URL to your BeyondTrust instance. Example: https://api.beyondtrust.io/siie For more information,
  /// see: https://docs.beyondtrust.com/bt-docs/docs/secrets-api#base-url
  apiUrl: String

  /// SiteID is your BeyondTrust Workload Credentials site identifier (UUID format). This identifier is
