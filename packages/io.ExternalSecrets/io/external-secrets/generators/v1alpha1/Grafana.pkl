/// Grafana represents a generator for Grafana service account tokens.
///
/// This module was generated from the CustomResourceDefinition at
/// <https://raw.githubusercontent.com/external-secrets/external-secrets/v2.12.0/config/crds/bases/kustomization.yaml>.
module io.`external-secrets`.generators.v1alpha1.Grafana

extends "@k8s/K8sResource.pkl"

import "@k8s/apimachinery/pkg/apis/meta/v1/ObjectMeta.pkl"

fixed apiVersion: "generators.external-secrets.io/v1alpha1"

fixed kind: "Grafana"

/// Standard object's metadata.
///
/// More info: <https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata>.
metadata: ObjectMeta?

/// GrafanaSpec controls the behavior of the grafana generator.
spec: Spec?

/// GrafanaSpec controls the behavior of the grafana generator.
class Spec {
  /// Auth is the authentication configuration to authenticate against the Grafana instance.
  auth: Auth

  /// ServiceAccount is the configuration for the service account that is supposed to be generated by the
  /// generator.
  serviceAccount: ServiceAccount

  /// URL is the URL of the Grafana instance.
  url: String
}

/// Auth is the authentication configuration to authenticate against the Grafana instance.
class Auth {
  /// Basic auth credentials used to authenticate against the Grafana instance. Note: you need a token
  /// which has elevated permissions to create service accounts. See here for the documentation on basic
  /// roles offered by Grafana:
  /// https://grafana.com/docs/grafana/latest/administration/roles-and-permissions/access-control/rbac-fixed-basic-role-definitions/
  basic: Basic?

  /// A service account token used to authenticate against the Grafana instance. Note: you need a token
  /// which has elevated permissions to create service accounts. See here for the documentation on basic
  /// roles offered by Grafana:
  /// https://grafana.com/docs/grafana/latest/administration/roles-and-permissions/access-control/rbac-fixed-basic-role-definitions/
  token: Token?
}

/// Basic auth credentials used to authenticate against the Grafana instance. Note: you need a token
/// which has elevated permissions to create service accounts. See here for the documentation on basic
/// roles offered by Grafana:
/// https://grafana.com/docs/grafana/latest/administration/roles-and-permissions/access-control/rbac-fixed-basic-role-definitions/
class Basic {
  /// A basic auth password used to authenticate against the Grafana instance.
  password: Password

  /// A basic auth username used to authenticate against the Grafana instance.
  username: String
}

/// A basic auth password used to authenticate against the Grafana instance.
class Password {
  /// The key where the token is found.
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))?

  /// The name of the Secret resource being referred to.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?
}

/// A service account token used to authenticate against the Grafana instance. Note: you need a token
/// which has elevated permissions to create service accounts. See here for the documentation on basic
/// roles offered by Grafana:
/// https://grafana.com/docs/grafana/latest/administration/roles-and-permissions/access-control/rbac-fixed-basic-role-definitions/
class Token {
  /// The key where the token is found.
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))?

  /// The name of the Secret resource being referred to.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?
}

/// ServiceAccount is the configuration for the service account that is supposed to be generated by the
/// generator.
class ServiceAccount {
  /// Name is the name of the service account that will be created by ESO.
  name: String

  /// Role is the role of the service account. See here for the documentation on basic roles offered by
  /// Grafana:
  /// https://grafana.com/docs/grafana/latest/administration/roles-and-permissions/access-control/rbac-fixed-basic-role-definitions/
  role: String

  /// SecondsToLive is the number of seconds before the generated service account token will expire. Some
  /// Grafana deployments (e.g. AWS Managed Grafana) require this value to be set.
  secondsToLive: Int(this >= 1)?
}
