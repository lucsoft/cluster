  /// pre-encode. Mutually exclusive with groupID.
  projectID: String(!isEmpty)?

  /// Scopes granted to the deploy token. At least one scope is required.
  scopes: Listing<
    "read_repository"
    |"read_registry"
    |"write_registry"
    |"read_package_registry"
    |"write_package_registry"
    |"read_virtual_registry"
    |"write_virtual_registry">(!isEmpty)

  /// URL configures the GitLab instance URL. Defaults to https://gitlab.com.
  url: String?

  /// Username is an optional username for the deploy token. GitLab defaults it to
  /// gitlab+deploy-token-{n} when omitted.
  username: String?
