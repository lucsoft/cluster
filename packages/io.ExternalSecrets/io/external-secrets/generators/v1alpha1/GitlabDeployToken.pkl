/// GitlabDeployTokenSpec defines the desired state to generate a GitLab deploy token.
spec: Spec?

/// GitlabDeployTokenSpec defines the desired state to generate a GitLab deploy token.
class Spec {
  /// Auth configures how ESO authenticates with the GitLab API.
  auth: Auth

  /// ExpiresAt is an optional expiry for the deploy token. If omitted the token does not expire on the
  /// GitLab side and is revoked only when the generator state is cleaned up (on regeneration or when the
  /// consuming ExternalSecret is deleted).
