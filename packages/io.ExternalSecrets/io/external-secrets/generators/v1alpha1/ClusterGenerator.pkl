  /// BeyondTrust Workload Credentials admin console. Example: a1b2c3d4-e5f6-4890-abcd-ef1234567890 For
  /// more information, see: https://docs.beyondtrust.com/bt-docs/docs/secrets-api
  siteId: String
}

