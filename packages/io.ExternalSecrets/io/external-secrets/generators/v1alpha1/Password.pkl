/// Password generates a random password based on the configuration parameters in spec. You can specify
/// the length, characterset and other attributes.
///
/// This module was generated from the CustomResourceDefinition at
/// <https://raw.githubusercontent.com/external-secrets/external-secrets/v2.12.0/config/crds/bases/kustomization.yaml>.
module io.`external-secrets`.generators.v1alpha1.Password

extends "@k8s/K8sResource.pkl"

import "@k8s/apimachinery/pkg/apis/meta/v1/ObjectMeta.pkl"

fixed apiVersion: "generators.external-secrets.io/v1alpha1"

fixed kind: "Password"

/// Standard object's metadata.
///
/// More info: <https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata>.
metadata: ObjectMeta?

/// PasswordSpec controls the behavior of the password generator.
spec: Spec?

/// PasswordSpec controls the behavior of the password generator.
class Spec {
  /// set AllowRepeat to true to allow repeating characters.
  allowRepeat: Boolean

  /// Digits specifies the number of digits in the generated password. If omitted it defaults to 25% of
  /// the length of the password
  digits: Int?

  /// Encoding specifies the encoding of the generated password. Valid values are: - "raw" (default): no
  /// encoding - "base64": standard base64 encoding - "base64url": base64url encoding - "base32": base32
  /// encoding - "hex": hexadecimal encoding
  encoding: ("base64"|"base64url"|"base32"|"hex"|"raw")?

  /// Length of the password to be generated. Defaults to 24
  length: Int

  /// Set NoUpper to disable uppercase characters
  noUpper: Boolean

  /// Prefix is prepended to every generated password after encoding. It is not counted in length or
  /// subject to the character settings.
  prefix: String?

  /// SecretKeys defines the keys that will be populated with generated passwords. Defaults to "password"
  /// when not set.
  secretKeys: Listing<String>(!isEmpty)?

  /// Suffix is appended to every generated password after encoding. It is not counted in length or
  /// subject to the character settings.
  suffix: String?

  /// SymbolCharacters specifies the special characters that should be used in the generated password.
  symbolCharacters: String?

  /// Symbols specifies the number of symbol characters in the generated password. If omitted it defaults
  /// to 25% of the length of the password
  symbols: Int?
}
