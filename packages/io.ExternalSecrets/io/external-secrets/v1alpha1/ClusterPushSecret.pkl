    |"GitlabDeployToken"
    |"QuayAccessToken"
    |"Password"
    |"SSHKey"
    |"STSSessionToken"
    |"UUID"
    |"VaultDynamicSecret"
    |"Webhook"
    |"Grafana"
    |"MFA"

  /// Specify the name of the generator resource
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))
}

/// Select a Secret to Push.
class Secret {
  /// Name of the Secret. The Secret must exist in the same namespace as the PushSecret manifest.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?

