  items: Listing<SecretItem>

  /// The name of the ConfigMap/Secret resource
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))
}

/// TemplateRefItem specifies a key in the ConfigMap/Secret to use as a template for Secret data.
class SecretItem {
  /// A key in the ConfigMap/Secret
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))

