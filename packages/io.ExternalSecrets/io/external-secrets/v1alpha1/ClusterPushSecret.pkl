  /// selectors are ORed.
  namespaceSelectors: Listing<NamespaceSelector>?

  /// The metadata of the external secrets to be created
  pushSecretMetadata: PushSecretMetadata?

  /// The name of the push secrets to be created. Defaults to the name of the ClusterPushSecret
  pushSecretName: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?

  /// PushSecretSpec defines what to do with the secrets.
  pushSecretSpec: PushSecretSpec

  /// The time in which the controller should reconcile its objects and recheck namespaces for labels.
  refreshTime: String?
}

/// A label selector is a label query over a set of resources. The result of matchLabels and
/// matchExpressions are ANDed. An empty label selector matches all objects. A null label selector
/// matches no objects.
class NamespaceSelector {
  /// matchExpressions is a list of label selector requirements. The requirements are ANDed.
  matchExpressions: Listing<SelectorMatchExpression>?

  /// matchLabels is a map of {key,value} pairs. A single {key,value} in the matchLabels map is
  /// equivalent to an element of matchExpressions, whose key field is "key", the operator is "In", and
  /// the values array contains only "value". The requirements are ANDed.
  matchLabels: Mapping<String, String>?
}

/// A label selector requirement is a selector that contains values, a key, and an operator that relates
/// the key and values.
class SelectorMatchExpression {
  /// key is the label key that the selector applies to.
  key: String

  /// operator represents a key's relationship to a set of values. Valid operators are In, NotIn, Exists
  /// and DoesNotExist.
  operator: String

  /// values is an array of string values. If the operator is In or NotIn, the values array must be
  /// non-empty. If the operator is Exists or DoesNotExist, the values array must be empty. This array is
  /// replaced during a strategic merge patch.
  values: Listing<String>?
}

/// The metadata of the external secrets to be created
class PushSecretMetadata {
  annotations: Mapping<String, String>?

  labels: Mapping<String, String>?
}

/// PushSecretSpec defines what to do with the secrets.
class PushSecretSpec {
  /// Secret Data that should be pushed to providers
  data: Listing<Datum>?

  /// DataTo defines bulk push rules that expand source Secret keys into provider entries.
  dataTo: Listing<DataTo>?

  /// Deletion Policy to handle Secrets in the provider.
  deletionPolicy: ("Delete"|"None")?

  /// The Interval to which External Secrets will try to push a secret definition
  refreshInterval: String?

  secretStoreRefs: Listing<SecretStoreRef>

  /// The Secret Selector (k8s source) for the Push Secret
  selector: Selector

  /// Template defines a blueprint for the created Secret resource.
  template: Template?

  /// UpdatePolicy to handle Secrets in the provider.
  updatePolicy: ("Replace"|"IfNotExists")?
}

/// PushSecretData defines data to be pushed to the provider and associated metadata.
class Datum {
  /// Used to define a conversion Strategy for the secret keys
  conversionStrategy: ("None"|"ReverseUnicode")?

  /// Match a given Secret Key to be pushed to the provider.
  match: Match

  /// Metadata is metadata attached to the secret. The structure of metadata is provider specific, please
  /// look it up in the provider documentation.
  metadata: Null?
}

/// Match a given Secret Key to be pushed to the provider.
class Match {
  /// Remote Refs to push to providers.
  remoteRef: RemoteRef

  /// Secret Key to be pushed
  secretKey: String?
}

/// Remote Refs to push to providers.
class RemoteRef {
  /// Name of the property in the resulting secret
  property: String?

  /// Name of the resulting provider secret.
  remoteKey: String
}

/// PushSecretDataTo defines how to bulk-push secrets to providers without explicit per-key mappings.
class DataTo {
  /// Used to define a conversion Strategy for the secret keys
  conversionStrategy: ("None"|"ReverseUnicode")?

  /// Match pattern for selecting keys from the source Secret. If not specified, all keys are selected.
  match: DataToMatch?

  /// Metadata is metadata attached to the secret. The structure of metadata is provider specific, please
  /// look it up in the provider documentation.
  metadata: Null?

  /// RemoteKey is the name of the single provider secret that will receive ALL matched keys bundled as a
  /// JSON object (e.g. {"DB_HOST":"...","DB_USER":"..."}). When set, per-key expansion is skipped and a
  /// single push is performed. The provider's store prefix (if any) is still prepended to this value.
  /// When not set, each matched key is pushed as its own individual provider secret.
  remoteKey: String?

  /// Rewrite operations to transform keys before pushing to the provider. Operations are applied
  /// sequentially.
  rewrite: Listing<Rewrite>?

  /// StoreRef specifies which SecretStore to push to. Required.
  storeRef: StoreRef?
}

/// Match pattern for selecting keys from the source Secret. If not specified, all keys are selected.
class DataToMatch {
  /// Regexp matches keys by regular expression. If not specified, all keys are matched.
  regexp: String?
}

/// PushSecretRewrite defines how to transform secret keys before pushing.
class Rewrite {
  /// Used to rewrite with regular expressions.
  regexp: Regexp?

  /// Used to apply string transformation on the secrets.
  transform: Transform?
}

/// Used to rewrite with regular expressions.
class Regexp {
  /// Used to define the regular expression of a re.Compiler.
  source: String

  /// Used to define the target pattern of a ReplaceAll operation.
  target: String
}

/// Used to apply string transformation on the secrets.
class Transform {
  /// Used to define the template to apply on the secret name. `.value ` will specify the secret name in
  /// the template.
  template: String
}

/// StoreRef specifies which SecretStore to push to. Required.
class StoreRef {
  /// Kind of the SecretStore resource (SecretStore or ClusterSecretStore)
  kind: ("SecretStore"|"ClusterSecretStore")?

  /// Optionally, sync to secret stores with label selector
  labelSelector: SecretStoreRefLabelSelector?

  /// Optionally, sync to the SecretStore of the given name
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?
}

/// Optionally, sync to secret stores with label selector
class SecretStoreRefLabelSelector {
  /// matchExpressions is a list of label selector requirements. The requirements are ANDed.
  matchExpressions: Listing<SelectorMatchExpression>?

  /// matchLabels is a map of {key,value} pairs. A single {key,value} in the matchLabels map is
  /// equivalent to an element of matchExpressions, whose key field is "key", the operator is "In", and
  /// the values array contains only "value". The requirements are ANDed.
  matchLabels: Mapping<String, String>?
}

/// PushSecretStoreRef contains a reference on how to sync to a SecretStore.
class SecretStoreRef {
  /// Kind of the SecretStore resource (SecretStore or ClusterSecretStore)
  kind: ("SecretStore"|"ClusterSecretStore")?

  /// Optionally, sync to secret stores with label selector
  labelSelector: SecretStoreRefLabelSelector?

  /// Optionally, sync to the SecretStore of the given name
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?
}

/// The Secret Selector (k8s source) for the Push Secret
class Selector {
  /// Point to a generator to create a Secret.
  generatorRef: GeneratorRef?

  /// Select a Secret to Push.
  secret: Secret?
}

/// Point to a generator to create a Secret.
