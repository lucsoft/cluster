  /// Specify the apiVersion of the generator resource
  apiVersion: String?

  /// Specify the Kind of the generator resource
  kind: 
    "ACRAccessToken"
    |"BeyondtrustWorkloadCredentialsDynamicSecret"
    |"ClusterGenerator"
    |"CloudsmithAccessToken"
    |"ECRAuthorizationToken"
