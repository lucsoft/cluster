/// IAM enables authentication to Conjur via the authn-iam authenticator.
class Iam {
  /// Account is the Conjur organization account name.
  account: String

  /// HostID is the Conjur host mapped to the AWS IAM role (e.g. "data/myapp/123456789012/MyRole").
  hostId: String

  /// Insecure allows authenticating to Conjur over plain HTTP. The AWS IAM authenticator sends a signed
  /// request as a bearer credential, so this should only be enabled when the connection is otherwise
