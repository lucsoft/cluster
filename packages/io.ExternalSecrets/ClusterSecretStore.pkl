  audiences: Listing<String>?

  /// The name of the ServiceAccount resource being referred to.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))

  /// Namespace of the resource being referred to. Ignored if referent is not cluster-scoped, otherwise
