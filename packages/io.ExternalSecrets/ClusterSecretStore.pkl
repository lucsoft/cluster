  clientKeyRef: ClientKeyRef

  /// Optional HostID for cert authentication (can be omitted when using 'spiffe' mode).
  hostId: String?

  /// The conjur authn cert webservice id
  serviceID: String
}

/// ClientCertRef is a reference to a specific 'key' containing the client certificate within a Secret
