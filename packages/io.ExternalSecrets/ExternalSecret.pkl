/// SyncWindows optionally restricts when periodic refreshes may occur. Evaluated in UTC, only for
/// Periodic refresh policy (or when refreshPolicy is unset).
class SyncWindows {
  /// Kind applies to every window in the list. "allow" -- syncs are permitted only while at least one
  /// window is active; all other times are blocked. "deny" -- syncs are blocked while any window is
  /// active; all other times are permitted.
  kind: "allow"|"deny"

  /// Windows is the list of schedule+duration pairs.
  windows: Listing<Window>(!isEmpty)
}

/// ExternalSecretSyncWindowEntry defines a single cron-schedule + duration pair within a SyncWindows
/// block.
class Window {
  /// Duration specifies how long the window stays open after each Schedule firing. Example: "8h".
  duration: String

  /// Schedule is a standard 5-field cron expression evaluated in UTC, or a named shorthand such as
  /// @daily or @every 1h. It marks the start time of each window occurrence. Example: "0 22 * * 1-5"
  /// opens a window every weekday at 22:00 UTC.
  schedule: String(!isEmpty, matches(Regex(#"^(@(annually|yearly|monthly|weekly|daily|midnight|hourly)|@every [^\s]+.*|[^\s]+( [^\s]+){4})$"#)))
}

