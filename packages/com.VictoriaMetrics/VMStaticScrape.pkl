/// VMScrapeParams defines VictoriaMetrics specific scrape parameters
class VmScrapeParams {
  /// DisableCompression
  disable_compression: Boolean?

  /// disable_keepalive allows disabling HTTP keep-alive when scraping targets. By default, HTTP
  /// keep-alive is enabled, so TCP connections to scrape targets could be reused. See
  /// https://docs.victoriametrics.com/victoriametrics/vmagent/#scrape_config-enhancements
  disable_keep_alive: Boolean?

  /// Headers allows sending custom headers to scrape targets must be in of semicolon separated header
  /// with it's value eg: headerName: headerValue vmagent and vmsingle support since 1.79.0 version
  headers: Listing<String>?

  no_stale_markers: Boolean?

  /// ProxyClientConfig configures proxy auth settings for scraping See feature description
  /// https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy
  proxy_client_config: ProxyClientConfig?

  scrape_align_interval: String?

  scrape_offset: String?

  stream_parse: Boolean?
}

/// ProxyClientConfig configures proxy auth settings for scraping See feature description
/// https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy
class ProxyClientConfig {
  /// Authorization with http header Authorization
  authorization: ProxyClientConfigAuthorization?

  /// BasicAuth allows proxy to authenticate over basic authentication
  basic_auth: ProxyClientConfigBasicAuth?

  /// Secret to mount to read bearer token for scraping targets proxy auth. The secret needs to be in the
  /// same namespace as the scrape object and accessible by the victoria-metrics operator.
  bearer_token: BearerToken?

  /// BearerTokenFile defines file to read bearer token from for proxy auth.
  bearer_token_file: String?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// TLSConfig configuration to use when scraping the endpoint
  tls_config: base.Dynamic?
}

/// BasicAuth allows proxy to authenticate over basic authentication
class ProxyClientConfigBasicAuth {
  /// Password defines reference for secret with password value The secret needs to be in the same
  /// namespace as scrape object
  password: BasicAuthPassword?

  /// PasswordFile defines path to password file at disk must be pre-mounted
  password_file: String?

  /// Username defines reference for secret with username value The secret needs to be in the same
  /// namespace as scrape object
  username: BasicAuthUsername?
}

/// Secret to mount to read bearer token for scraping targets proxy auth. The secret needs to be in the
/// same namespace as the scrape object and accessible by the victoria-metrics operator.
class BearerToken {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

