amends "package://pkg.pkl-lang.org/pkl-pantry/k8s.contrib.crd@4.2.6#/generate.pkl"

import "pkl:yaml"

import "@k8s/api/autoscaling/v2/HorizontalPodAutoscaler.pkl"
import "@k8s/api/core/v1/PersistentVolumeClaim.pkl"
import "@k8s/api/core/v1/PodSpec.pkl"
import "@k8s/api/core/v1/Probe.pkl"
import "@k8s/api/core/v1/Service.pkl"
import "@k8s/api/core/v1/Volume.pkl"

// renovate: datasource=github-releases packageName=VictoriaMetrics/operator
local version = "v0.74.1"
local crdBundle =
  "https://raw.githubusercontent.com/VictoriaMetrics/operator/\(version)/config/crd/overlay/crd.yaml"

/// Unlike most operators, VictoriaMetrics does not commit `config/crd/bases/*.yaml` — those are
/// generated at build time. The only CRD source in the tagged tree is a single ~6 MB bundle holding
/// all 24 CRDs, so we parse it once and pick the kinds we model.
///
/// This is every CRD in the **`v1beta1`** group, which is the group `baseApiGroup` below flattens
/// to the package root. The eight remaining kinds (`vlagents`, `vlclusters`, `vlsingles`,
/// `vmanomalies`, `vmanomalyconfigs`, `vmdistributed`, `vtclusters`, `vtsingles`) serve `v1` /
/// `v1alpha1` and would generate into a nested `com/victoriametrics/operator/v1/` directory,
/// forcing consumers into imports like `@VictoriaMetrics/com/victoriametrics/operator/v1/VTSingle.pkl`.
/// Adding them means a second generator pass with its own `baseApiGroup`, not another line here.
local wanted = List(
  "vlogs.operator.victoriametrics.com",
  "vmagents.operator.victoriametrics.com",
  "vmalertmanagerconfigs.operator.victoriametrics.com",
  "vmalertmanagers.operator.victoriametrics.com",
  "vmalerts.operator.victoriametrics.com",
  "vmauths.operator.victoriametrics.com",
  "vmclusters.operator.victoriametrics.com",
  "vmnodescrapes.operator.victoriametrics.com",
  "vmpodscrapes.operator.victoriametrics.com",
  "vmprobes.operator.victoriametrics.com",
  "vmrules.operator.victoriametrics.com",
  "vmscrapeconfigs.operator.victoriametrics.com",
  "vmservicescrapes.operator.victoriametrics.com",
  "vmsingles.operator.victoriametrics.com",
  "vmstaticscrapes.operator.victoriametrics.com",
  "vmusers.operator.victoriametrics.com",
)

source = crdBundle
baseApiGroup = "v1beta1.operator.victoriametrics.com"

k8sImportPath = "@k8s"

sourceContents =
  new YamlRenderer {
    isStream = true
  }.renderDocument(
    new yaml.Parser {}
      .parseAll(read(crdBundle))
      .toList()
      .filter((doc) -> wanted.contains((doc as Dynamic).metadata.name)),
  )

/// Without these the generated modules are close to unusable in two ways.
///
/// 1. Every workload CRD declares its embedded Kubernetes objects (`containers`, `volumes`,
///    `affinity`, the probes, `serviceSpec.spec`, …) as bare opaque objects, which generate as
///    `Dynamic` — no field names, no validation. They are mapped back onto the real `@k8s` types.
/// 2. Roughly 180 fields are `x-kubernetes-preserve-unknown-fields` *without* a `type`, and those
///    generate as `Null` — a field whose only legal value is `null`. That covers things you cannot
///    do without: every relabel config's `regex` and `if`, every `tls_config`, VMAuth's
///    `url_prefix`, and `gceSDConfigs[].zone`, which is *required*, making that class impossible to
///    construct at all. They become `Dynamic`, which is as precise as the CRD allows.
///
/// Left deliberately as `Dynamic`: `http_config`, `tlsConfig`, `oauth2`, VMAuth's `extraRules`, the
/// whole of VLogs' `spec`, and `serviceScrapeSpec` — these are VictoriaMetrics' own untyped
/// escape hatches with no schema to recover.

