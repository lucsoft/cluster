/// VMScrapeConfig specifies a set of targets and parameters describing how to scrape them.
///
/// This module was generated from the CustomResourceDefinition at
/// <https://raw.githubusercontent.com/VictoriaMetrics/operator/v0.72.0/config/crd/overlay/crd.yaml>.
module com.victoriametrics.operator.v1beta1.VMScrapeConfig

extends "@k8s/K8sResource.pkl"

import "@k8s/apimachinery/pkg/apis/meta/v1/ObjectMeta.pkl"
import "pkl:base"

fixed apiVersion: "operator.victoriametrics.com/v1beta1"

fixed kind: "VMScrapeConfig"

/// Standard object's metadata.
///
/// More info: <https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata>.
metadata: ObjectMeta?

/// VMScrapeConfigSpec defines the desired state of VMScrapeConfig
spec: Spec?

/// ScrapeObjectStatus defines the observed state of ScrapeObjects
status: Status?

/// VMScrapeConfigSpec defines the desired state of VMScrapeConfig
class Spec {
  /// Authorization with http header Authorization
  authorization: VultrSDConfigProxyClientConfigAuthorization?

  /// AzureSDConfigs defines a list of Azure service discovery configurations.
  azureSDConfigs: Listing<AzureSDConfig>?

  /// BasicAuth allow an endpoint to authenticate over basic authentication
  basicAuth: SpecBasicAuth?

  /// File to read bearer token for scraping targets.
  bearerTokenFile: String?

  /// Secret to mount to read bearer token for scraping targets. The secret needs to be in the same
  /// namespace as the scrape object and accessible by the victoria-metrics operator.
  bearerTokenSecret: BearerTokenSecret?

  /// ConsulAgentSDConfigs defines a list of Consul Agent service discovery configurations.
  consulAgentSDConfigs: Listing<ConsulAgentSDConfig>?

  /// ConsulSDConfigs defines a list of Consul service discovery configurations.
  consulSDConfigs: Listing<ConsulSDConfig>?

  /// DigitalOceanSDConfigs defines a list of DigitalOcean service discovery configurations.
  digitalOceanSDConfigs: Listing<DigitalOceanSDConfig>?

  /// DNSSDConfigs defines a list of DNS service discovery configurations.
  dnsSDConfigs: Listing<DnsSDConfig>?

  /// DockerSDConfigs defines a list of Docker service discovery configurations.
  dockerSDConfigs: Listing<DockerSDConfig>?

  /// DockerSwarmSDConfigs defines a list of Docker Swarm service discovery configurations.
  dockerSwarmSDConfigs: Listing<DockerSwarmSDConfig>?

  /// EC2SDConfigs defines a list of EC2 service discovery configurations.
  ec2SDConfigs: Listing<Ec2SDConfig>?

  /// EurekaSDConfigs defines a list of Eureka service discovery configurations.
  eurekaSDConfigs: Listing<EurekaSDConfig>?

  /// FileSDConfigs defines a list of file service discovery configurations.
  fileSDConfigs: Listing<FileSDConfig>?

  /// FollowRedirects controls redirects for scraping.
  follow_redirects: Boolean?

  /// GCESDConfigs defines a list of GCE service discovery configurations.
  gceSDConfigs: Listing<GceSDConfig>?

  /// HetznerSDConfigs defines a list of Hetzner service discovery configurations.
  hetznerSDConfigs: Listing<HetznerSDConfig>?

  /// HonorLabels chooses the metric's labels on collisions with target labels.
  honorLabels: Boolean?

  /// HonorTimestamps controls whether vmagent or vmsingle respects the timestamps present in scraped
  /// data.
  honorTimestamps: Boolean?

  /// HTTPSDConfigs defines a list of HTTP service discovery configurations.
  httpSDConfigs: Listing<HttpSDConfig>?

  /// Interval at which metrics should be scraped
  interval: String?

  /// KubernetesSDConfigs defines a list of Kubernetes service discovery configurations.
  kubernetesSDConfigs: Listing<KubernetesSDConfig>?

  /// KumaSDConfigs defines a list of Kuma service discovery configurations.
  kumaSDConfigs: Listing<KumaSDConfig>?

  /// MarathonSDConfigs defines a list of Marathon service discovery configurations.
  marathonSDConfigs: Listing<MarathonSDConfig>?

  /// MaxScrapeSize defines a maximum size of scraped data for a job
  max_scrape_size: String?

  /// MetricRelabelConfigs to apply to samples after scrapping.
  metricRelabelConfigs: Listing<RelabelConfig>?

  /// NomadSDConfigs defines a list of Nomad service discovery configurations.
  nomadSDConfigs: Listing<NomadSDConfig>?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// OpenStackSDConfigs defines a list of OpenStack service discovery configurations.
  openstackSDConfigs: Listing<OpenstackSDConfig>?

  /// OVHCloudSDConfigs defines a list of OVH Cloud service discovery configurations.
  ovhcloudSDConfigs: Listing<OvhcloudSDConfig>?

  /// Optional HTTP URL parameters
  params: Mapping<String, Listing<String>>?

  /// HTTP path to scrape for metrics.
  path: String?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// PuppetDBSDConfigs defines a list of PuppetDB service discovery configurations.
  puppetDBSDConfigs: Listing<PuppetDBSDConfig>?

  /// RelabelConfigs to apply to samples during service discovery.
  relabelConfigs: Listing<RelabelConfig>?

  /// SampleLimit defines per-scrape limit on number of scraped samples that will be accepted.
  sampleLimit: Int?

  /// HTTP scheme to use for scraping.
  scheme: ("http"|"https"|"HTTPS"|"HTTP")?

  /// ScrapeInterval is the same as Interval and has priority over it. one of scrape_interval or interval
  /// can be used
  scrape_interval: String?

  /// ScrapeClass defined scrape class to apply
  scrapeClass: String?

  /// Timeout after which the scrape is ended
  scrapeTimeout: String?

  /// SeriesLimit defines per-scrape limit on number of unique time series a single target can expose
  /// during all the scrapes on the time window of 24h.
  seriesLimit: Int?

  /// StaticConfigs defines a list of static targets with a common label set.
  staticConfigs: Listing<StaticConfig>?

  /// TLSConfig configuration to use when scraping the endpoint
  tlsConfig: TlsConfig?

  /// VMScrapeParams defines VictoriaMetrics specific scrape parameters
  vm_scrape_params: VmScrapeParams?

  /// VultrSDConfigs defines a list of Vultr service discovery configurations.
  vultrSDConfigs: Listing<VultrSDConfig>?

  /// YandexCloudSDConfigs defines a list of Yandex Cloud service discovery configurations.
  yandexCloudSDConfigs: Listing<YandexCloudSDConfig>?
}

