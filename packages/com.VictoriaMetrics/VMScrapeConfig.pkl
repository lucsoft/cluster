/// ConsulAgentSDConfig configurations allows retrieving scrape targets from a local Consul Agent. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#consulagent_sd_configs)
class ConsulAgentSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Consul Datacenter name, if not provided it will use the local Consul Agent Datacenter.
  datacenter: String?

  /// Filter defines filter for service discovery requests. See
  /// https://developer.hashicorp.com/consul/api-docs/features/filtering
  filter: String?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Namespaces are only supported in Consul Enterprise.
  namespace: String?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// HTTP Scheme default "http"
  scheme: ("HTTP"|"HTTPS"|"http"|"https")?

  /// Server address of the Consul Agent. Defaults to localhost:8500.
  server: String?

  /// A list of services for which targets are retrieved. If omitted, all services are scraped.
  services: Listing<String>?

  /// The string by which Consul tags are joined into the tag label.
  tagSeparator: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?

  /// Consul ACL TokenRef, if not provided it will use the ACL from the local Consul Agent.
  tokenRef: ConsulSDConfigTokenRef?
}

/// Consul ACL TokenRef, if not provided it will use the ACL from the local Consul Agent.
class ConsulSDConfigTokenRef {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// ConsulSDConfig defines a Consul service discovery configuration. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#consul_sd_configs)
class ConsulSDConfig {
  /// Allow stale Consul results (see
  /// https://developer.hashicorp.com/consul/api-docs/features/consistency ). Will reduce load on Consul.
  /// If unset, use its default value.
  allowStale: Boolean?

  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Consul Datacenter name, if not provided it will use the local Consul Agent Datacenter.
  datacenter: String?

  /// Filter defines filter for /v1/catalog/services requests See
  /// https://developer.hashicorp.com/consul/api-docs/features/filtering
  filter: String?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Namespaces are only supported in Consul Enterprise.
  namespace: String?

  /// Node metadata key/value pairs to filter nodes for a given service.
  nodeMeta: Mapping<String, String>?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// Admin Partitions are only supported in Consul Enterprise.
  partition: String?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// HTTP Scheme default "http"
  scheme: ("HTTP"|"HTTPS")?

  /// A valid string consisting of a hostname or IP followed by an optional port number.
  server: String(!isEmpty)

  /// A list of services for which targets are retrieved. If omitted, all services are scraped.
  services: Listing<String>?

  /// The string by which Consul tags are joined into the tag label. If unset, use its default value.
  tagSeparator: String?

  /// An optional list of tags used to filter nodes for a given service. Services must contain all tags
  /// in the list.
  tags: Listing<String>?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?

  /// Consul ACL TokenRef, if not provided it will use the ACL from the local Consul Agent.
  tokenRef: ConsulSDConfigTokenRef?
}

/// DigitalOceanSDConfig allow retrieving scrape targets from DigitalOcean's Droplets API. This service
/// discovery uses the public IPv4 address by default, by that can be changed with relabeling. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#digitalocean_sd_configs)
class DigitalOceanSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// The port to scrape metrics from.
  port: Int?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Server is an optional DigitalOcean API server to query. By default, https://api.digitalocean.com is
  /// used.
  server: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// DNSSDConfig allows specifying a set of DNS domain names which are periodically queried to discover a
/// list of targets. The DNS servers to be contacted are read from /etc/resolv.conf. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#dns_sd_configs)
class DnsSDConfig {
  /// A list of DNS domain names to be queried.
  names: Listing<String>(!isEmpty)

  /// The port number used if the query type is not SRV Ignored for SRV records
  port: Int?

  type: ("SRV"|"A"|"AAAA"|"MX")?
}

/// DockerSDConfig configurations allows retrieving scrape targets from Docker Engine. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#docker_sd_configs)
class DockerSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Filters are optional filters to limit the discovery process to a subset of available resources.
  filters: Listing<DockerSwarmSDConfigFilter>?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Host to connect to the Docker daemon. Defaults to unix:///var/run/docker.sock.
  host: String?

  /// HostNetworkingHost is used when containers are in host networking mode.
  hostNetworkingHost: String?

  /// MatchFirstNetwork controls whether to match the first network if there are multiple networks.
  matchFirstNetwork: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// Port to scrape metrics from, when containers expose multiple ports.
  port: Int?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// DockerFilter defines a filter for Docker service discovery.
class DockerSwarmSDConfigFilter {
  /// Name of the filter.
  name: String

  /// Values for the filter.
  values: Listing<String>
}

/// DockerSwarmSDConfig configurations allows retrieving scrape targets from Docker Swarm. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#dockerswarm_sd_configs)
class DockerSwarmSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Filters are optional filters to limit the discovery process to a subset of available resources.
  filters: Listing<DockerSwarmSDConfigFilter>?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Host to connect to the Docker daemon.
  host: String

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// Port to scrape metrics from, when containers expose multiple ports.
  port: Int?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Role of the target in Docker Swarm.
  role: "services"|"tasks"|"nodes"

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// EC2SDConfig allow retrieving scrape targets from AWS EC2 instances. The private IP address is used by
/// default, but may be changed to the public IP address with relabeling. The IAM credentials used must
/// have the ec2:DescribeInstances permission to discover scrape targets. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#ec2_sd_configs)
class Ec2SDConfig {
  /// AccessKey is the AWS API key.
  accessKey: AccessKey?

  /// Filters can be used optionally to filter the instance list by other criteria. Available filter
  /// criteria can be found here:
  /// https://docs.aws.amazon.com/AWSEC2/latest/APIReference/API_DescribeInstances.html Filter API
  /// documentation: https://docs.aws.amazon.com/AWSEC2/latest/APIReference/API_Filter.html
  filters: Listing<Filter>?

  /// The port to scrape metrics from. If using the public IP address, this must instead be specified in
  /// the relabeling rule.
  port: Int?

  /// The AWS region
  region: String?

  /// AWS Role ARN, an alternative to using AWS API keys.
  roleARN: String?

  /// SecretKey is the AWS API secret.
  secretKey: SecretKey?
}

/// AccessKey is the AWS API key.
class AccessKey {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// EC2Filter is the configuration for filtering EC2 instances.
class Filter {
  name: String

  values: Listing<String>
}

/// SecretKey is the AWS API secret.
class SecretKey {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// EurekaSDConfig configurations allows retrieving scrape targets from Eureka REST API. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#eureka_sd_configs)
class EurekaSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Server is an optional URL to connect to the Eureka server. By default, the
  /// http://localhost:8080/eureka/v2 is used.
  server: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// FileSDConfig defines a file service discovery configuration. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#file_sd_configs)
class FileSDConfig {
  /// List of files to be used for file discovery.
  files: Listing<String>(!isEmpty)
}

/// GCESDConfig configures scrape targets from GCP GCE instances. The private IP address is used by
/// default, but may be changed to the public IP address with relabeling. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#gce_sd_configs)
///
/// The GCE service discovery will load the Google Cloud credentials from the file specified by the
/// GOOGLE_APPLICATION_CREDENTIALS environment variable. See
/// https://cloud.google.com/kubernetes-engine/docs/tutorials/authenticating-to-cloud-platform
class GceSDConfig {
  /// Filter can be used optionally to filter the instance list by other criteria Syntax of this filter
  /// is described in the filter query parameter section:
  /// https://cloud.google.com/compute/docs/reference/latest/instances/list
  filter: String?

  /// The port to scrape metrics from. If using the public IP address, this must instead be specified in
  /// the relabeling rule.
  port: Int?

  /// The Google Cloud Project ID
  project: String(!isEmpty)

  /// The tag separator is used to separate the tags on concatenation
  tagSeparator: String?

  /// The zone of the scrape targets. If you need multiple zones use multiple GCESDConfigs.
  zone: base.Dynamic
}

/// HetznerSDConfig configurations allows retrieving scrape targets from Hetzner Cloud and Hetzner Robot.
/// See [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#hetzner_sd_configs)
class HetznerSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// Port is an optional port to scrape metrics from
  port: Int?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Role defines mandatory Hetzner role for entity discovery.
  role: "robot"|"Robot"|"hcloud"|"Cloud"

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// HTTPSDConfig defines a HTTP service discovery configuration. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#http_sd_configs)
class HttpSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?

  /// URL from which the targets are fetched.
  url: String(!isEmpty, matches(Regex("^http(s)?://.+$")))
}

/// KubernetesSDConfig allows retrieving scrape targets from Kubernetes' REST API. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#kubernetes_sd_configs)
class KubernetesSDConfig {
  /// The API server address consisting of a hostname or IP address followed by an optional port number.
  /// If left empty, assuming process is running inside of the cluster. It will discover API servers
  /// automatically and use the pod's CA certificate and bearer token file at
  /// /var/run/secrets/kubernetes.io/serviceaccount/.
  apiServer: String?

  /// AttachMetadata configures metadata attaching from service discovery
  attach_metadata: AttachMetadata?

  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Optional namespace discovery. If omitted, discover targets across all namespaces.
  namespaces: Namespaces?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Role of the Kubernetes entities that should be discovered.
  role: "node"|"pod"|"service"|"endpoints"|"endpointslice"|"ingress"

  /// Selector to select objects.
  selectors: Listing<Selector>?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// AttachMetadata configures metadata attaching from service discovery
class AttachMetadata {
  /// Namespace instructs vmagent or vmsingle to add namespace specific metadata from service discovery
  /// Valid for roles: pod, service, endpoints, endpointslice, ingress.
  namespace: Boolean?

  /// Node instructs vmagent or vmsingle to add node specific metadata from service discovery Valid for
  /// roles: pod, endpoints, endpointslice.
  node: Boolean?
}

/// Optional namespace discovery. If omitted, discover targets across all namespaces.
class Namespaces {
  /// List of namespaces where to watch for resources. If empty and `ownNamespace` isn't true, watch for
  /// resources in all namespaces.
  names: Listing<String>?

  /// Includes the namespace in which the pod exists to the list of watched namespaces.
  ownNamespace: Boolean?
}

/// K8SSelectorConfig is Kubernetes Selector Config
class Selector {
  field: String?

  label: String?

  role: "node"|"pod"|"service"|"endpoints"|"endpointslice"|"ingress"
}

/// KumaSDConfig configurations allows retrieving scrape targets from Kuma control plane. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#kuma_sd_configs)
class KumaSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// ClientID is an optional client ID to send to Kuma Control Plane. The hostname of the server where
  /// vmagent runs is used if it isn't set. If the hostname is empty, then "vmagent" string is used as
  /// client_id.
  clientID: String?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Server must contain the URL of Kuma Control Plane's MADS xDS server.
  server: String(!isEmpty)

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// MarathonSDConfig configurations allows retrieving scrape targets from Marathon. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#marathon_sd_configs)
class MarathonSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Servers is a list of Marathon servers.
  servers: Listing<String>(!isEmpty)

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// RelabelConfig allows dynamic rewriting of the label set More info:
/// https://docs.victoriametrics.com/victoriametrics/#relabeling
class RelabelConfig {
  /// Action to perform based on regex matching. Default is 'replace'
  action: String?

  /// If represents metricsQL match expression (or list of expressions): '{__name__=~"foo_.*"}'
  `if`: base.Dynamic?

  /// Labels is used together with Match for `action: graphite`
  labels: Mapping<String, String>?

  /// Match is used together with Labels for `action: graphite`
  match: String?

  /// Modulus to take of the hash of the source label values.
  modulus: Int?

  /// Regular expression against which the extracted value is matched. Default is '(.*)' victoriaMetrics
  /// supports multiline regex joined with |
  /// https://docs.victoriametrics.com/victoriametrics/vmagent/#relabeling-enhancements
  regex: base.Dynamic?

  /// Replacement value against which a regex replace is performed if the regular expression matches.
  /// Regex capture groups are available. Default is '$1'
  replacement: String?

  /// Separator placed between concatenated source label values. default is ';'.
  separator: String?

  /// UnderScoreSourceLabels - additional form of source labels source_labels for compatibility with
  /// original relabel config. if set both sourceLabels and source_labels, sourceLabels has priority. for
  /// details https://github.com/VictoriaMetrics/operator/issues/131
  source_labels: Listing<String>?

  /// The source labels select values from existing labels. Their content is concatenated using the
  /// configured separator and matched against the configured regular expression for the replace, keep,
  /// and drop actions.
  sourceLabels: Listing<String>?

  /// UnderScoreTargetLabel - additional form of target label - target_label for compatibility with
  /// original relabel config. if set both targetLabel and target_label, targetLabel has priority. for
  /// details https://github.com/VictoriaMetrics/operator/issues/131
  target_label: String?

  /// Label to which the resulting value is written in a replace action. It is mandatory for replace
  /// actions. Regex capture groups are available.
  targetLabel: String?
}

/// NomadSDConfig configurations allow retrieving scrape targets from Nomad's Service API. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#nomad_sd_configs)
class NomadSDConfig {
  /// Allow stale Nomad results to reduce load on Nomad. If unset, use its default value.
  allowStale: Boolean?

  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Namespace to use for Nomad service discovery.
  namespace: String?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Region to use for Nomad service discovery.
  region: String?

  /// A valid string consisting of a hostname or IP followed by an optional port number.
  server: String(!isEmpty)

  /// The string by which Nomad tags are joined into the tag label. If unset, use its default value.
  tagSeparator: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// OpenStackSDConfig allow retrieving scrape targets from OpenStack Nova instances. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#openstack_sd_configs)
class OpenstackSDConfig {
  /// Whether the service discovery should list all instances for all projects. It is only relevant for
  /// the 'instance' role and usually requires admin permissions.
  allTenants: Boolean?

  /// ApplicationCredentialID
  applicationCredentialId: String?

  /// The ApplicationCredentialID or ApplicationCredentialName fields are required if using an
  /// application credential to authenticate. Some providers allow you to create an application
  /// credential to authenticate rather than a password.
  applicationCredentialName: String?

  /// The applicationCredentialSecret field is required if using an application credential to
  /// authenticate.
  applicationCredentialSecret: ApplicationCredentialSecret?

  /// Availability of the endpoint to connect to.
  availability: ("Public"|"public"|"Admin"|"admin"|"Internal"|"internal")?

  /// DomainID
  domainID: String?

  /// At most one of domainId and domainName must be provided if using username with Identity V3.
  /// Otherwise, either are optional.
  domainName: String?

  /// IdentityEndpoint specifies the HTTP endpoint that is required to work with the Identity API of the
  /// appropriate version.
  identityEndpoint: String?

  /// Password for the Identity V2 and V3 APIs. Consult with your provider's control panel to discover
  /// your account's preferred method of authentication.
  password: OpenstackSDConfigPassword?

  /// The port to scrape metrics from. If using the public IP address, this must instead be specified in
  /// the relabeling rule.
  port: Int?

  /// ProjectID
  projectID: String?

  /// The ProjectId and ProjectName fields are optional for the Identity V2 API. Some providers allow you
  /// to specify a ProjectName instead of the ProjectId. Some require both. Your provider's
  /// authentication policies will determine how these fields influence authentication.
  projectName: String?

  /// The OpenStack Region.
  region: String(!isEmpty)

  /// The OpenStack role of entities that should be discovered.
  role: "Instance"|"instance"|"Hypervisor"|"hypervisor"

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?

  /// UserID
  userid: String?

  /// Username is required if using Identity V2 API. Consult with your provider's control panel to
  /// discover your account's username. In Identity V3, either userid or a combination of username and
  /// domainId or domainName are needed
  username: String?
}

/// The applicationCredentialSecret field is required if using an application credential to authenticate.
class ApplicationCredentialSecret {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// Password for the Identity V2 and V3 APIs. Consult with your provider's control panel to discover your
/// account's preferred method of authentication.
class OpenstackSDConfigPassword {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// OVHCloudSDConfig configurations allows retrieving scrape targets from OVH Cloud VPS and OVH Cloud
/// dedicated server. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#ovhcloud_sd_configs)
class OvhcloudSDConfig {
  /// ApplicationKey defines a self generated token.
  applicationKey: String(!isEmpty)

  /// ApplicationSecret defines a generated secret.
  applicationSecret: ApplicationSecret

  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// ConsumerKey holds user/app specific token
  consumerKey: ConsumerKey

  /// Endpoint defines OVH Cloud endpoint
  endpoint: String?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Service could be either `vps` or `dedicated_server`
  service: "vps"|"VPS"|"dedicated_server"|"DedicatedServer"

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// ApplicationSecret defines a generated secret.
class ApplicationSecret {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// ConsumerKey holds user/app specific token
class ConsumerKey {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// PuppetDBSDConfig configurations allows retrieving scrape targets from PuppetDB resources. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#puppetdb_sd_configs)
class PuppetDBSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// IncludeParameters defines if parameters should be included as meta labels.
  includeParameters: Boolean?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// Port defines port to scrape metrics from
  port: Int?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Query defines PQL query that allows to filter discovered resources.
  query: String

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?

  /// URL of the PuppetDB root query endpoint
  url: String
}

/// StaticConfig defines a static configuration. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#static_configs)
class StaticConfig {
  /// Labels assigned to all metrics scraped from the targets.
  labels: Mapping<String, String>?

  /// List of targets for this static configuration.
  targets: Listing<String>?
}

/// TLSConfig configuration to use when scraping the endpoint
class TlsConfig {
  /// Struct containing the CA cert to use for the targets.
  ca: Ca?

  /// Path to the CA cert in the container to use for the targets.
  caFile: String?

  /// Struct containing the client cert file for the targets.
  cert: Cert?

  /// Path to the client cert file in the container for the targets.
  certFile: String?

  /// Disable target certificate validation.
  insecureSkipVerify: Boolean?

  /// Path to the client key file in the container for the targets.
  keyFile: String?

  /// Secret containing the client key file for the targets.
  keySecret: KeySecret?

  /// Used to verify the hostname for the targets.
  serverName: String?
}

/// VMScrapeParams defines VictoriaMetrics specific scrape parameters
class VmScrapeParams {
  /// DisableCompression
  disable_compression: Boolean?

  /// disable_keepalive allows disabling HTTP keep-alive when scraping targets. By default, HTTP
  /// keep-alive is enabled, so TCP connections to scrape targets could be reused. See
  /// https://docs.victoriametrics.com/victoriametrics/vmagent/#scrape_config-enhancements
  disable_keep_alive: Boolean?

  /// Headers allows sending custom headers to scrape targets must be in of semicolon separated header
  /// with it's value eg: headerName: headerValue vmagent and vmsingle support since 1.79.0 version
  headers: Listing<String>?

  no_stale_markers: Boolean?

  /// ProxyClientConfig configures proxy auth settings for scraping See feature description
  /// https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy
  proxy_client_config: VmScrapeParamsProxyClientConfig?

  scrape_align_interval: String?

  scrape_offset: String?

  stream_parse: Boolean?
}

/// ProxyClientConfig configures proxy auth settings for scraping See feature description
/// https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy
class VmScrapeParamsProxyClientConfig {
  /// Authorization with http header Authorization
  authorization: VultrSDConfigProxyClientConfigAuthorization?

  /// BasicAuth allows proxy to authenticate over basic authentication
  basic_auth: ProxyClientConfigBasicAuth?

  /// Secret to mount to read bearer token for scraping targets proxy auth. The secret needs to be in the
  /// same namespace as the scrape object and accessible by the victoria-metrics operator.
  bearer_token: BearerToken?

  /// BearerTokenFile defines file to read bearer token from for proxy auth.
  bearer_token_file: String?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// TLSConfig configuration to use when scraping the endpoint
  tls_config: base.Dynamic?
}

/// VultrSDConfig configurations allows retrieving scrape targets from Vultr instances. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#vultr_sd_configs)
class VultrSDConfig {
  /// Authorization header to use on every scrape request.
  authorization: Authorization?

  /// BasicAuth information to use on every scrape request.
  basicAuth: VultrSDConfigBasicAuth?

  /// FirewallGroupID is an optional query arguments to filter instances by firewall group id.
  firewallGroupID: String?

  /// Configure whether HTTP requests follow HTTP 3xx redirects.
  followRedirects: Boolean?

  /// Hostname is an optional query arguments to filter instances by hostname.
  hostname: String?

  /// Label is an optional query arguments to filter instances by label.
  label: String?

  /// MainIP is an optional query arguments to filter instances by main ip address.
  mainIP: String?

  /// OAuth2 defines auth configuration
  oauth2: ProxyClientConfigOauth2?

  /// Port is an optional port to scrape metrics from.
  port: Int?

  /// ProxyClientConfig configures proxy auth settings for scraping See [feature
  /// description](https://docs.victoriametrics.com/victoriametrics/vmagent/#scraping-targets-via-a-proxy)
  proxy_client_config: VultrSDConfigProxyClientConfig?

  /// ProxyURL eg http://proxyserver:2195 Directs scrapes to proxy through this endpoint.
  proxyURL: String?

  /// Region is an optional query arguments to filter instances by region id.
  region: String?

  /// TLS configuration to use on every scrape request
  tlsConfig: VultrSDConfigTlsConfig?
}

/// YandexCloudSDConfig configurations allows retrieving scrape targets from Yandex Cloud. See
/// [here](https://docs.victoriametrics.com/victoriametrics/sd_configs/#yandexcloud_sd_configs)
class YandexCloudSDConfig {
  /// APIEndpoint is the Yandex Cloud API endpoint.
  apiEndpoint: String?

  /// FolderIDs are the Yandex Cloud folder IDs to discover resources in.
  folderIDs: Listing<String>?

  /// Service is the Yandex Cloud service to discover targets for.
  service: "compute"|"ydb"

  /// TLSConfig to use on every scrape request.
  tlsConfig: YandexCloudSDConfigTlsConfig?

  /// YandexPassportOAuthToken is the Yandex Passport OAuth token.
  yandexPassportOAuthToken: YandexPassportOAuthToken?
}

/// TLSConfig to use on every scrape request.
class YandexCloudSDConfigTlsConfig {
  /// Struct containing the CA cert to use for the targets.
  ca: Ca?

  /// Path to the CA cert in the container to use for the targets.
  caFile: String?

  /// Struct containing the client cert file for the targets.
  cert: Cert?

  /// Path to the client cert file in the container for the targets.
  certFile: String?

  /// Disable target certificate validation.
  insecureSkipVerify: Boolean?

  /// Path to the client key file in the container for the targets.
  keyFile: String?

  /// Secret containing the client key file for the targets.
  keySecret: KeySecret?

  /// Used to verify the hostname for the targets.
  serverName: String?
}

/// YandexPassportOAuthToken is the Yandex Passport OAuth token.
class YandexPassportOAuthToken {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// ScrapeObjectStatus defines the observed state of ScrapeObjects
class Status {
  /// Known .status.conditions.type are: "Available", "Progressing", and "Degraded"
  conditions: Listing<Condition>?

  /// ObservedGeneration defines current generation picked by operator for the reconcile
  observedGeneration: Int?

  /// Reason defines human readable error reason
  reason: String?

  /// UpdateStatus defines a status for update rollout
  updateStatus: String?
}

/// Condition defines status condition of the resource
class Condition {
  /// lastTransitionTime is the last time the condition transitioned from one status to another.
  lastTransitionTime: String

  /// LastUpdateTime is the last time of given type update. This value is used for status TTL update and
  /// removal
  lastUpdateTime: String

  /// message is a human readable message indicating details about the transition. This may be an empty
  /// string.
  message: String(length <= 32768)?

  /// observedGeneration represents the .metadata.generation that the condition was set based upon. For
  /// instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration
  /// is 9, the condition is out of date with respect to the current state of the instance.
  observedGeneration: Int(isPositive)?

  /// reason contains a programmatic identifier indicating the reason for the condition's last
  /// transition. Producers of specific condition types may define expected values and meanings for this
  /// field, and whether the values are considered a guaranteed API. The value should be a CamelCase
  /// string. This field may not be empty.
  reason: String(length.isBetween(1, 1024))

  /// status of the condition, one of True, False, Unknown.
  status: "True"|"False"|"Unknown"

  /// Type of condition in CamelCase or in name.namespace.resource.victoriametrics.com/CamelCase.
  type: String(length <= 316)
}
