  volumeMounts: Listing<VolumeMount>?

  /// Volumes allows configuration of additional volumes on the output Deployment/StatefulSet definition.
  /// Volumes specified will be appended to other volumes that are generated. / +optional
  volumes: Listing<Volume>?
}

/// ConfigReloadAuthKeySecret defines optional secret reference authKey for /-/reload API requests. Given
