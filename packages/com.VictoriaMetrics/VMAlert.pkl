/// License allows to configure license key to be used for enterprise features. Using license key is
/// supported starting from VictoriaMetrics v1.94.0. See
/// [here](https://docs.victoriametrics.com/victoriametrics/enterprise/)
class License {
  /// Enforce offline verification of the license key.
  forceOffline: Boolean?

  /// Enterprise license key. This flag is available only in [VictoriaMetrics
  /// enterprise](https://docs.victoriametrics.com/victoriametrics/enterprise/). To request a trial
  /// license, [go to](https://victoriametrics.com/products/enterprise/trial)
  key: String?

  /// KeyRef is reference to secret with license key for enterprise features.
  keyRef: KeyRef?

  /// Interval to be used for checking for license key changes. Note that this is only applicable when
  /// using KeyRef.
  reloadInterval: String?
}

/// KeyRef is reference to secret with license key for enterprise features.
class KeyRef {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
