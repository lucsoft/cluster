/// IncidentioConfig configures notifications via incident.io.
/// https://prometheus.io/docs/alerting/latest/configuration/#incidentio_config available from v0.66.0
/// operator version and v0.29.0 alertmanager version
class IncidentioConfig {
  /// AlertSourceToken is used to authenticate with incident.io. Mutually exclusive with
  /// AlertSourceTokenFile.
  alert_source_token: AlertSourceToken?

  /// AlertSourceTokenFile defines the path to a file that contains the alert source token. Mutually
  /// exclusive with AlertSourceToken.
  alert_source_token_file: String?

  http_config: base.Dynamic?

  /// MaxAlerts defines maximum number of alerts to be sent per incident.io message.
  max_alerts: Int?

  /// SendResolved controls notify about resolved alerts.
  send_resolved: Boolean?

  /// Timeout is the maximum time allowed to invoke incident.io
  timeout: String?

  /// The URL to send the incident.io alert. This would typically be provided by the incident.io team
  /// when setting up an alert source. Mutually exclusive with URLFile.
  url: String?

  /// URLFile defines the path to a file that holds the incident.io alert URL. Mutually exclusive with
  /// URL.
  url_file: String?
}

/// AlertSourceToken is used to authenticate with incident.io. Mutually exclusive with
/// AlertSourceTokenFile.
class AlertSourceToken {
  /// The key of the secret to select from. Must be a valid secret key.
  key: String

  /// Name of the referent. This field is effectively required, but due to backwards compatibility is
  /// allowed to be empty. Instances of this type with an empty value here are almost certainly wrong.
  /// More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
  name: String?

  /// Specify whether the Secret or its key must be defined
  optional: Boolean?
}

/// JiraConfig represent alertmanager's jira_config entry
/// https://prometheus.io/docs/alerting/latest/configuration/#jira_config available from v0.55.0 operator
/// version and v0.28.0 alertmanager version
class JiraConfig {
  /// The URL to send API requests to. The full API path must be included. Example:
  /// https://company.atlassian.net/rest/api/2/
  api_url: String?

  /// Other issue and custom fields. Jira issue field can have multiple types. Depends on the field type,
  /// the values must be provided differently. See
  /// https://developer.atlassian.com/server/jira/platform/jira-rest-api-examples/#setting-custom-field-data-for-other-field-types
  /// for further examples.
  custom_fields: Mapping<String, base.Dynamic>?

  /// Issue description template.
  description: String?

  /// The HTTP client's configuration. You must use this configuration to supply the personal access
  /// token (PAT) as part of the HTTP `Authorization` header. For Jira Cloud, use basic_auth with the
  /// email address as the username and the PAT as the password. For Jira Data Center, use the
  /// 'authorization' field with 'credentials: <PAT value>'.
  http_config: base.Dynamic?

  /// Type of the issue (e.g. Bug)
  issue_type: String

  /// Labels to be added to the issue
  labels: Listing<String>?

  /// Priority of the issue
  priority: String?

  /// The project key where issues are created
  project: String

  /// If reopen_transition is defined, reopen the issue when it is not older than this value (rounded
  /// down to the nearest minute). The resolutiondate field is used to determine the age of the issue.
  reopen_duration: String(matches(Regex("^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$")))?

  /// Name of the workflow transition to resolve an issue. The target status must have the category
  /// "done".
  reopen_transition: String?

  /// Name of the workflow transition to reopen an issue. The target status should not have the category
  /// "done".
  resolve_transition: String?

  /// SendResolved controls notify about resolved alerts.
  send_resolved: Boolean?

  /// Issue summary template
  summary: String?

  /// If reopen_transition is defined, ignore issues with that resolution.
  wont_fix_resolution: String?
}

/// MattermostConfig configures notifications via Mattermost.
class MattermostConfig {
  /// Attachments defines richer formatting options
  attachments: Listing<Attachment>?

  /// Channel overrides the channel the message posts in.
  channel: String?

  http_config: base.Dynamic?

  /// IconEmoji overrides the profile picture and icon_url parameter.
  icon_emoji: String?

  /// IconURL overrides the profile picture the message posts with.
  icon_url: String?

  priority: Priority?

  props: Props?

  /// SendResolved controls notify about resolved alerts.
  send_resolved: Boolean?

  /// Text defines markdown-formatted message to display in the post.
  text: String

  /// URL to send requests to, one of `urlSecret` and `url` must be defined.
  url: String?

  /// URLSecret defines secret name and key at the CRD namespace. It must contain the Mattermost URL. one
  /// of `urlSecret` and `url` must be defined.
  url_secret: UrlSecret?

  /// Username overrides the username the message posts as
  username: String?
}

class Attachment {
  author_icon: String?

  author_link: String?

  author_name: String?

  color: String?

  fallback: String?

  fields: Listing<Field>?

  footer: String?

  footer_icon: String?

  image_url: String?

  pretext: String?

  text: String?

  thumb_url: String?

  title: String?

  title_link: String?
}

class Field {
  short: Boolean?

  title: String?

  value: String?
}

class Priority {
  persistent_notifications: Boolean?

  priority: String?

  requested_ack: Boolean?
}

class Props {
  card: String?
}

/// URLSecret defines secret name and key at the CRD namespace. It must contain the Mattermost URL. one
/// of `urlSecret` and `url` must be defined.
class UrlSecret {
  /// The key of the secret to select from. Must be a valid secret key.
