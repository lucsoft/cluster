/// TargetRef describes target for user traffic forwarding. one of target types can be chosen: crd or
/// static per targetRef. user can define multiple targetRefs with different ref Types.
class TargetRef {
  /// CRD describes exist operator's CRD object, operator generates access url based on CRD params.
  crd: Crd?

  /// DiscoverBackendIPs instructs discovering URLPrefix backend IPs via DNS.
  discover_backend_ips: Boolean?

  /// DropSrcPathPrefixParts is the number of `/`-delimited request path prefix parts to drop before
