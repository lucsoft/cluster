  /// 1.68.0 version of vmauth
  headers: Listing<String>?

  hosts: Listing<String>?

  /// LoadBalancingPolicy defines load balancing policy to use for backend urls. Supported policies:
  /// least_loaded, first_available. See
  /// [here](https://docs.victoriametrics.com/victoriametrics/vmauth/#load-balancing) for more details
  /// (default "least_loaded")
  load_balancing_policy: ("least_loaded"|"first_available")?

  /// Name references item at VMAuths spec.defaultTargetRefs map, with name set other attributes are
  /// skipped
  name: String?

  /// Paths - matched path to route.
