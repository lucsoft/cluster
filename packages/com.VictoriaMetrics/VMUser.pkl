  /// QueryArgs appends list of query arguments to generated URL
  query_args: Listing<QueryArg>?

  /// ResponseHeaders represent additional http headers, that vmauth adds for request response in form of
  /// ["header_key: header_value"] multiple values for header key: ["header_key: value1,value2"] it's
  /// available since 1.93.0 version of vmauth
  response_headers: Listing<String>?

  /// RetryStatusCodes defines http status codes in numeric format for request retries Can be defined per
  /// target or at VMUser.spec level e.g. [429,503]
  retry_status_codes: Listing<Int>?

  /// SrcHeaders is an optional list of headers, which must match request headers.
  src_headers: Listing<String>?

  /// SrcQueryArgs is an optional list of query args, which must match request URL query args.
  src_query_args: Listing<String>?

  /// Static - user defined url for traffic forward, for instance http://vmsingle:8428
  static: Static?

  /// TargetPathSuffix allows to add some suffix to the target path It allows to hide tenant
