amends "package://pkg.pkl-lang.org/pkl-pantry/k8s.contrib.crd@4.2.6#/generate.pkl"

import "pkl:yaml"

// renovate: datasource=github-releases packageName=argoproj/argo-cd
local version = "v3.4.6"
local baseUrl = "https://raw.githubusercontent.com/argoproj/argo-cd/\(version)/manifests/crds"
// noinspection UnresolvedElement
local kustomize: Listing<String> =
  new yaml.Parser {}.parse(read("\(baseUrl)/kustomization.yaml")).resources

source = "\(baseUrl)/kustomization.yaml"
baseApiGroup = "v1alpha1.argoproj.io"

k8sImportPath = "@k8s"

sourceContents =
  new YamlRenderer {
    isStream = true
  }.renderDocument(
    kustomize
      .toList()
      .map((item) -> (new yaml.Parser {}.parse(read("\(baseUrl)/\(item)")) as Dynamic)),
  )

// The CRD declares valuesObject as a free-form object, so the generator types it as
// `Dynamic`. Widen it to any object type, which lets a typed values module -- the ones
// pkl-helmchart generates -- be assigned without converting it to a Dynamic first.
output {
  files {
    for (path, file in super.files) {
      [path] = (file) {
        text =
          file.text.replaceAll("valuesObject: Dynamic?", "valuesObject: (Dynamic|Typed|Mapping)?")
      }
    }
  }
}
