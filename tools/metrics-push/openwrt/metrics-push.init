#!/bin/sh /etc/rc.common
# procd service for metrics-push. Install as /etc/init.d/metrics-push.

USE_PROCD=1
# After network, so the first push has an uplink to use.
START=95
STOP=10

CONF=/etc/metrics-push.conf

start_service() {
    if [ ! -r "$CONF" ]; then
        echo "metrics-push: $CONF is missing or unreadable" >&2
        return 1
    fi

    # shellcheck disable=SC1090
    . "$CONF"

    procd_open_instance
    procd_set_param command /usr/bin/metrics-push
    # Passed as env rather than argv so the token never shows up in `ps`.
    procd_set_param env \
        METRICS_PUSH_URL="$METRICS_PUSH_URL" \
        METRICS_PUSH_TOKEN="$METRICS_PUSH_TOKEN" \
        METRICS_PUSH_INSTANCE="$METRICS_PUSH_INSTANCE" \
        METRICS_PUSH_INTERVAL="$METRICS_PUSH_INTERVAL"
    # Infinite retries, 5s apart. The process only exits on a config error, which respawning
    # won't fix, but a crash loop is still better than silently going dark.
    procd_set_param respawn 3600 5 0
    # Per-tick errors go to stderr; this puts them in `logread`.
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger network
}
